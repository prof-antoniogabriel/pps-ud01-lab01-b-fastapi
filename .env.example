# Nombre descriptivo de la aplicación.
# Se utiliza para identificar la API en la configuración y, si el código lo usa,
# puede mostrarse también en la documentación generada por FastAPI.
APP_NAME=API de avisos

# Entorno en el que se está ejecutando la aplicación.
# En este caso indica que estamos trabajando en modo de desarrollo.
# Otros valores habituales podrían ser production, testing o staging.
APP_ENV=development

# Número máximo de avisos que la aplicación permitirá manejar o devolver,
# según cómo esté implementada esta variable en la lógica del proyecto.
NOTICE_LIMIT=50